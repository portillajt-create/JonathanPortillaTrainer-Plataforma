# Copia este archivo a ".env" y complétalo con los datos de tu proyecto Supabase
# (Supabase Dashboard -> Project Settings -> API)

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# Opcional (Paso 3): credenciales SMTP para que el centro de notificaciones
# también envíe correo (además de la notificación in-app, que no depende
# de esto). Si las dejas vacías, la app simplemente no envía el correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
