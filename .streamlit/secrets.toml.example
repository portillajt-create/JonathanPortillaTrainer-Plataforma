# Si despliegas en Streamlit Community Cloud, copia este archivo a
# ".streamlit/secrets.toml" (NO lo subas a git) y complétalo.

SUPABASE_URL = "https://TU_PROYECTO.supabase.co"
SUPABASE_ANON_KEY = "TU_ANON_PUBLIC_KEY"

# Opcional: credenciales SMTP para que el centro de notificaciones también
# envíe correo (además de la notificación in-app, que no depende de esto).
# Si las dejas vacías/sin poner, la app simplemente no envía el correo.
SMTP_HOST = ""
SMTP_PORT = "587"
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_FROM = ""

# Opcional: correo del entrenador/admin que recibe el aviso de "cliente
# nuevo registrado". Si lo dejas sin poner, usa el valor por defecto fijo
# en config.py.
ADMIN_NOTIFICATION_EMAIL = ""
